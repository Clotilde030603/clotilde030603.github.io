---
import PublicLayout from '../layouts/PublicLayout.astro';
import { formatDate } from '../lib/public/content';
import { getBlogContent } from '../lib/public/load-content';

const { categories, posts } = await getBlogContent();
const recentPosts = [...posts]
  .sort((left, right) => Date.parse(right.publishedAt) - Date.parse(left.publishedAt))
  .slice(0, 3);
---

<PublicLayout
  categories={categories}
  posts={posts}
  homePage
  description="보안과 개인정보 분야를 공부하면서 배운 내용과 생각을 끄적끄적 기록하는 공간입니다."
>
  <section class="home-page" aria-labelledby="home-title">
    <div class="home-character" aria-label="Dorami 토끼 애니메이션">
      <dorami-rabbit wide hide-controls></dorami-rabbit>
    </div>
    <div class="home-copy">
      <p class="listing-eyebrow">Welcome to Dorami!</p>
      <h1 id="home-title">Dorami</h1>
      <p class="home-description">보안과 개인정보 분야를 공부하면서 배운 내용과 생각을 끄적끄적 기록하는 공간입니다.</p>
      <p class="home-signature">Dorami, also known as Clotilde.</p>
      <a class="home-posts-link" href="/posts/">Browse Posts <span aria-hidden="true">→</span></a>
    </div>
  </section>
  {
    recentPosts.length > 0 && (
      <section class="home-recent" aria-labelledby="recent-posts-title">
        <header>
          <h2 id="recent-posts-title">최근 글</h2>
          <a href="/posts/">전체 글 보기</a>
        </header>
        <ol class="home-recent-grid">
          {recentPosts.map((post, index) => (
            <li class="home-recent-card">
              <div class="home-recent-meta">
                <span class="home-recent-index">{String(index + 1).padStart(2, '0')}</span>
                {post.categoryName && post.categorySlug && (
                  <a href={`/category/${encodeURIComponent(post.categorySlug)}/`}>{post.categoryName}</a>
                )}
                <time datetime={post.publishedAt}>{formatDate(post.publishedAt)}</time>
              </div>
              <h3><a href={`/posts/${encodeURIComponent(post.slug)}/`}>{post.title}</a></h3>
              {post.summary && <p>{post.summary}</p>}
              <a class="home-recent-open" href={`/posts/${encodeURIComponent(post.slug)}/`} aria-label={`${post.title} 읽기`}>
                <span aria-hidden="true">↗</span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    )
  }
</PublicLayout>
