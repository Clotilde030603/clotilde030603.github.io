---
import { AdminApp } from '../../components/admin/AdminApp';
import type { AdminSection } from '../../lib/admin/types';
import '../../styles/admin.css';
export function getStaticPaths() {
  return ['about','categories','media','templates','comments','analytics','deployments','import','backup','trash'].map((section) => ({ params:{ section }, props:{ section } }));
}
const section = Astro.props.section as AdminSection;
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="referrer" content="no-referrer" />
    <meta http-equiv="Content-Security-Policy" content="object-src 'none'; base-uri 'self'; form-action 'self'" />
    <style is:inline>html:not([data-dorami-top-level]) body { visibility: hidden; }</style>
    <script is:inline>if (window.top === window.self) document.documentElement.setAttribute('data-dorami-top-level', '');</script>
    <link rel="icon" type="image/png" href="/dorami-cartoon/dorami-rabbit-face.png" />
    <title>Dorami 관리자</title>
  </head>
  <body><AdminApp client:only="react" initialSection={section} /></body>
</html>
