---
import PublicLayout from '../layouts/PublicLayout.astro';
import DocumentContent from '../components/public/DocumentContent.astro';
import { getBlogContent } from '../lib/public/load-content';

const { categories, posts, about } = await getBlogContent();
---

<PublicLayout title="About" categories={categories} posts={posts} canonicalPath="/about/" hideSidebar>
  <article class="about-page">
    <header><h1 class="listing-eyebrow">About</h1></header>
    <section class="about-profile" aria-label="프로필">
      <img src="/dorami-cartoon/dorami-rabbit-face.png" alt="Dorami 토끼 캐릭터" width="144" height="144" />
      <div class="about-profile-copy">
        <p class="about-profile-nickname">Dorami</p>
        <p class="about-profile-name">이가현 <span aria-hidden="true">·</span> Clotilde</p>
        <nav class="about-profile-links" aria-label="프로필 링크">
          <a href="mailto:kyoungmi1765@gmail.com">Email</a>
          <a href="https://low-hare-4b9.notion.site/PORTFOLIO-167fb795d5ab8084b70dfa0fae89a770" target="_blank" rel="noreferrer">Notion Portfolio <span aria-hidden="true">↗</span></a>
          <a href="https://github.com/Clotilde030603" target="_blank" rel="me noreferrer">GitHub <span aria-hidden="true">↗</span></a>
          <a href="https://learntoflyclotilde.tistory.com/" target="_blank" rel="noreferrer">Blog <span aria-hidden="true">↗</span></a>
        </nav>
      </div>
    </section>
    <section class="about-highlights" aria-label="핵심 정보">
      <div><strong>4.13 / 4.5</strong><span>Academic</span></div>
      <div><strong>BoB 13기</strong><span>보안컨설팅</span></div>
      <div><strong>2개</strong><span>자격</span></div>
      <div><strong>7회</strong><span>수상</span></div>
    </section>
    {
      about ? (
        <DocumentContent document={about} />
      ) : (
        <section class="empty-state">
          <p class="empty-title">소개 글을 준비하고 있습니다.</p>
          <p>확인되지 않은 이력이나 자격은 대신 채우지 않습니다.</p>
        </section>
      )
    }
  </article>
</PublicLayout>
