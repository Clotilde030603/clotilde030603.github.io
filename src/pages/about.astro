---
import PublicLayout from '../layouts/PublicLayout.astro';
import DocumentContent from '../components/public/DocumentContent.astro';
import { categories, snapshot } from '../lib/public/content';
---

<PublicLayout title="소개" categories={categories} canonicalPath="/about/">
  <article class="about-page">
    <header><p class="listing-eyebrow">About</p><h1>소개</h1></header>
    {
      snapshot.about ? (
        <DocumentContent document={snapshot.about} />
      ) : (
        <section class="empty-state">
          <p class="empty-title">소개 글을 준비하고 있습니다.</p>
          <p>확인되지 않은 이력이나 자격은 대신 채우지 않습니다.</p>
        </section>
      )
    }
  </article>
</PublicLayout>
