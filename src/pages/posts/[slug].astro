---
import type { GetStaticPaths } from 'astro';
import PublicLayout from '../../layouts/PublicLayout.astro';
import DocumentContent from '../../components/public/DocumentContent.astro';
import Comments from '../../components/public/Comments.astro';
import RedirectPage from '../../components/public/RedirectPage.astro';
import { categories, categoryById, categoryPath, formatDate, posts, slugAliases } from '../../lib/public/content';
import { buildPublicPostPaths } from '../../lib/public/post-paths';
import { renderDocument, safeHref } from '../../lib/public/render-document';
import type { PublishedPost } from '../../lib/types';

export const getStaticPaths = (() => buildPublicPostPaths(posts, slugAliases)) satisfies GetStaticPaths;

interface Props { post: PublishedPost; redirectTo: string | null }
const { post, redirectTo } = Astro.props;
const category = post.categoryId ? categoryById.get(post.categoryId) : undefined;
const breadcrumbs = categoryPath(post.categoryId);
const { headings } = renderDocument(post.document);
const postIndex = posts.findIndex((item) => item.id === post.id);
const newerPost = postIndex > 0 ? posts[postIndex - 1] : null;
const olderPost = postIndex >= 0 && postIndex < posts.length - 1 ? posts[postIndex + 1] : null;
const apiBase = import.meta.env.PUBLIC_SUPABASE_URL
  ? `${import.meta.env.PUBLIC_SUPABASE_URL}/functions/v1`
  : '';
const apiKey = import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY ?? '';
const sourceUrl = safeHref(post.sourceUrl);
---

{redirectTo ? <RedirectPage targetPath={redirectTo} /> : <PublicLayout
  title={post.title}
  description={post.summary}
  categories={categories}
  activeCategoryId={post.categoryId}
  canonicalPath={`/posts/${post.slug}/`}
  articlePublishedAt={post.publishedAt}
>
  <article class="article" data-public-post-id={post.id} data-view-api={apiBase} data-api-key={apiKey}>
    {
      breadcrumbs.length > 0 && (
        <nav class="breadcrumbs" aria-label="글 위치">
          {breadcrumbs.map((item, index) => (
            <>
              {index > 0 && <span aria-hidden="true">/</span>}
              <a href={`/category/${encodeURIComponent(item.slug)}/`}>{item.name}</a>
            </>
          ))}
        </nav>
      )
    }
    <header class="article-header">
      <h1>{post.title}</h1>
      <div class="article-meta">
        {category && <span>{category.name}</span>}
        <time datetime={post.publishedAt}>작성 {formatDate(post.publishedAt)}</time>
        {post.updatedAt && <time datetime={post.updatedAt}>수정 {formatDate(post.updatedAt)}</time>}
      </div>
      {post.tags.length > 0 && (
        <div class="article-tags" aria-label="태그">
          {post.tags.map((tag) => <a href={`/tag/${encodeURIComponent(tag)}/`}>#{tag}</a>)}
        </div>
      )}
    </header>

    <div class="article-layout">
      <div class="article-body">
        {post.summary && <p class="article-lead">{post.summary}</p>}
        <DocumentContent document={post.document} />
        {sourceUrl && (
          <p class="source-link"><a href={sourceUrl} rel="noreferrer">원문 출처 보기</a></p>
        )}
      </div>
      {
        headings.length > 1 && (
          <aside class="article-toc" aria-label="목차">
            <p>목차</p>
            <ol>
              {headings.map((heading) => (
                <li class={`toc-level-${heading.level}`}><a href={`#${heading.id}`}>{heading.text}</a></li>
              ))}
            </ol>
          </aside>
        )
      }
    </div>

    <nav class="post-neighbors" aria-label="이전 및 다음 글">
      {olderPost ? <a href={`/posts/${encodeURIComponent(olderPost.slug)}/`}><span>이전 글</span>{olderPost.title}</a> : <span></span>}
      {newerPost ? <a class="next" href={`/posts/${encodeURIComponent(newerPost.slug)}/`}><span>다음 글</span>{newerPost.title}</a> : <span></span>}
    </nav>
    <Comments postId={post.id} enabled={post.commentsEnabled} visible={post.commentsVisible} />
  </article>
</PublicLayout>}

<script>
  const article = document.querySelector<HTMLElement>('[data-public-post-id]');
  if (article?.dataset.viewApi) {
    const storageKey = 'dorami-session-id';
    let sessionId = '';
    try {
      sessionId = sessionStorage.getItem(storageKey) ?? '';
      if (!sessionId) {
        sessionId = crypto.randomUUID?.() ?? `${Date.now()}-${Math.random()}`;
        sessionStorage.setItem(storageKey, sessionId);
      }
    } catch {
      sessionId = crypto.randomUUID?.() ?? `${Date.now()}-${Math.random()}`;
    }
    const apiKey = article.dataset.apiKey ?? '';
    void fetch(`${article.dataset.viewApi}/record-view`, {
      method: 'POST',
      keepalive: true,
      headers: {
        ...(apiKey ? { apikey: apiKey } : {}),
        'content-type': 'application/json',
      },
      body: JSON.stringify({ postId: article.dataset.publicPostId, sessionId }),
    }).catch(() => undefined);
  }
</script>
