---
import type { GetStaticPaths } from 'astro';
import PublicLayout from '../../layouts/PublicLayout.astro';
import DocumentContent from '../../components/public/DocumentContent.astro';
import { categoryPath, formatDate } from '../../lib/public/content';
import { getBlogContent } from '../../lib/public/load-content';
import { renderDocument } from '../../lib/public/render-document';
import type { BlogContent } from '../../lib/public/content';
import type { PublishedPost } from '../../lib/types';

export const getStaticPaths = (async () => {
  const content = await getBlogContent();
  return content.posts.map((post) => ({ params: { slug: post.slug }, props: { post, content } }));
}) satisfies GetStaticPaths;

interface Props { post: PublishedPost; content: BlogContent }
const { post, content } = Astro.props;
const breadcrumbs = categoryPath(post.categoryId, content.categories);
const { headings } = renderDocument(post.document);
const postIndex = content.posts.findIndex((item) => item.id === post.id);
const newerPost = postIndex > 0 ? content.posts[postIndex - 1] : null;
const olderPost = postIndex >= 0 && postIndex < content.posts.length - 1 ? content.posts[postIndex + 1] : null;
---

<PublicLayout
  title={post.title}
  description={post.summary}
  categories={content.categories}
  posts={content.posts}
  activeCategoryId={post.categoryId}
  canonicalPath={`/posts/${post.slug}/`}
  articlePublishedAt={post.publishedAt}
>
  <article class="article">
    {
      breadcrumbs.length > 0 && (
        <nav class="breadcrumbs" aria-label="글 위치">
          {breadcrumbs.map((item, index) => (
            <>
              {index > 0 && <span aria-hidden="true">/</span>}
              <a href={`/category/${encodeURIComponent(item.slug)}/`}>{item.name}</a>
            </>
          ))}
        </nav>
      )
    }
    <header class="article-header">
      <h1>{post.title}</h1>
      {post.summary && <p class="article-summary">{post.summary}</p>}
      <div class="article-meta">
        {post.categoryName && <span>{post.categoryName}</span>}
        <time datetime={post.publishedAt}>작성 {formatDate(post.publishedAt)}</time>
        {post.updatedAt && <time datetime={post.updatedAt}>수정 {formatDate(post.updatedAt)}</time>}
      </div>
      {post.tags.length > 0 && (
        <div class="article-tags" aria-label="태그">
          {post.tags.map((tag) => <a href={`/tag/${encodeURIComponent(tag)}/`}>#{tag}</a>)}
        </div>
      )}
    </header>

    <div class="article-layout">
      {
        headings.length > 1 && (
          <aside class="article-toc" aria-label="목차">
            <p>목차</p>
            <ol>
              {headings.map((heading) => (
                <li class={`toc-level-${heading.level}`}><a href={`#${heading.id}`} title={heading.text}>{heading.text}</a></li>
              ))}
            </ol>
          </aside>
        )
      }
      <div class="article-body">
        <DocumentContent document={post.document} />
      </div>
    </div>

    <nav class="post-neighbors" aria-label="이전 및 다음 글">
      {olderPost ? <a href={`/posts/${encodeURIComponent(olderPost.slug)}/`}><span>이전 글</span>{olderPost.title}</a> : <span></span>}
      {newerPost ? <a class="next" href={`/posts/${encodeURIComponent(newerPost.slug)}/`}><span>다음 글</span>{newerPost.title}</a> : <span></span>}
    </nav>
  </article>
</PublicLayout>
