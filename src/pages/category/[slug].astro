---
import type { GetStaticPaths } from 'astro';
import PublicLayout from '../../layouts/PublicLayout.astro';
import ListingPage from '../../components/public/ListingPage.astro';
import { postsInCategory } from '../../lib/public/content';
import { getBlogContent } from '../../lib/public/load-content';
import type { BlogContent } from '../../lib/public/content';
import type { Category, PublishedPost } from '../../lib/types';

export const getStaticPaths = (async () => {
  const content = await getBlogContent();
  return content.categories.map((category) => ({
    params: { slug: category.slug },
    props: { category, categoryPosts: postsInCategory(category.id, content.categories, content.posts), content },
  }));
}) satisfies GetStaticPaths;

interface Props { category: Category; categoryPosts: PublishedPost[]; content: BlogContent }
const { category, categoryPosts, content } = Astro.props;
---

<PublicLayout
  title={category.name}
  categories={content.categories}
  posts={content.posts}
  activeCategoryId={category.id}
  canonicalPath={`/category/${category.slug}/`}
>
  <ListingPage
    title={category.name}
    eyebrow="카테고리"
    posts={categoryPosts}
    emptyTitle="이 카테고리에는 아직 발행된 글이 없습니다."
  />
</PublicLayout>
