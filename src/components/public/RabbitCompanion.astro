<div class="rabbit-companion" data-rabbit-companion>
  <div class="rabbit-stage" aria-label="노트북으로 글을 쓰는 Dorami 토끼" role="img">
    <svg class="rabbit-scene" viewBox="0 0 240 220" aria-hidden="true" focusable="false">
      <g class="rabbit-character" stroke="#627258" stroke-linecap="round" stroke-linejoin="round">
        <svg class="rabbit-head" x="33" y="4" width="135" height="157" viewBox="0 0 275 320" overflow="hidden">
          <image href="/preferred-rabbit-logo.png" x="-365" y="-100" width="1536" height="1024" />
        </svg>
        <g class="rabbit-body" fill="#FEFEFC" stroke-width="5">
          <path d="M60 151c-14 7-20 22-20 40 0 16 13 23 30 23h32c20 0 32-11 34-30" />
        </g>
      </g>
      <g class="rabbit-laptop" transform="translate(4 48) scale(.95 .8)" stroke="#627258" stroke-linecap="round" stroke-linejoin="round">
        <g class="rabbit-laptop-lid">
          <path fill="#F4F5F1" stroke-width="5" d="M125 129h87l-14 61h-88l15-61Z" />
          <path fill="#AEB4AA" stroke="none" d="M161 154c4-4 10-4 14 0 3 4 2 10-2 13-4 3-10 2-13-2-2-4-2-8 1-11Z" />
        </g>
        <path class="rabbit-laptop-base" fill="#FEFEFC" stroke-width="5" d="M105 190h98c5 0 8 4 6 8-2 4-7 6-13 6h-91c-6 0-10-2-11-6-1-4 4-8 11-8Z" />
      </g>
    </svg>
  </div>
  <button type="button" class="motion-toggle" aria-pressed="false" data-motion-toggle>
    움직임 멈춤
  </button>
</div>

<script>
  for (const companion of document.querySelectorAll<HTMLElement>('[data-rabbit-companion]')) {
    const toggle = companion.querySelector<HTMLButtonElement>('[data-motion-toggle]');
    if (!toggle || toggle.dataset.bound === 'true') continue;
    toggle.dataset.bound = 'true';
    toggle.addEventListener('click', () => {
      const paused = companion.classList.toggle('motion-paused');
      toggle.setAttribute('aria-pressed', String(paused));
      toggle.textContent = paused ? '움직임 재생' : '움직임 멈춤';
    });
  }
</script>
