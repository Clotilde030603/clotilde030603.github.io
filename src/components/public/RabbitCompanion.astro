---
import RabbitHead from './RabbitHead.astro';
---

<div class="rabbit-companion" data-rabbit-companion>
  <div class="rabbit-stage" aria-label="멀리서 깡충깡충 뛰어와 앉은 뒤 맥북으로 작업하는 Dorami 토끼" role="img">
    <svg class="rabbit-scene rabbit-scene--hopping" viewBox="50 15 290 320" aria-hidden="true" focusable="false">
      <g fill="#fff" stroke="#286B32" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
        <path d="M91 270c-13-2-23 7-24 19-1 9 5 15 16 17" />
        <path d="M116 228c-20 8-34 27-34 50 0 19 14 30 40 33 27 3 54-2 67-17 10-13 8-34-4-47-9-10-20-14-34-16" />
        <path d="M96 299c-8 2-14 8-13 14 5 7 22 8 35 1m46-14c7 9 20 13 30 8" fill="none" />
        <path d="M164 253c14 11 18 25 14 35" fill="none" />
      </g>
      <RabbitHead />
    </svg>

    <svg class="rabbit-scene rabbit-scene--working" viewBox="50 15 290 320" aria-hidden="true" focusable="false">
      <defs>
        <linearGradient id="dorami-screen" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#f8f9f8" />
          <stop offset="1" stop-color="#d8dadd" />
        </linearGradient>
      </defs>
      <g fill="#fff" stroke="#286B32" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
        <path d="M88 269c-12-2-21 7-22 19-1 11 6 17 20 18" />
        <path d="M111 228c-19 13-30 33-31 59-1 15 7 26 23 27l78 1c17 0 25-13 25-29 0-19-10-37-23-48" />
        <path d="M86 306c-2 9 8 12 27 11h58" fill="none" />
      </g>
      <RabbitHead />
      <g class="rabbit-paw rabbit-paw--left" fill="none" stroke="#286B32" stroke-width="2.7" stroke-linecap="round" stroke-linejoin="round">
        <path d="M123 269c8 15 22 22 38 22" />
        <path d="M158 287l11 7" />
      </g>
      <g class="rabbit-paw rabbit-paw--right" fill="none" stroke="#286B32" stroke-width="2.7" stroke-linecap="round" stroke-linejoin="round">
        <path d="M166 254c11 8 17 18 18 30" />
        <path d="M181 281l9 11" />
      </g>
      <g class="rabbit-laptop-base" fill="#f5f6f4" stroke="#286B32" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M134 299h167l-5 14c-2 4-6 6-11 6H132c-7 0-9-4-6-10l8-10z" />
        <path d="M136 302h68" fill="none" stroke="#aeb3ad" stroke-width="1.6" />
      </g>
      <g class="rabbit-laptop-lid" stroke="#286B32" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
        <path d="M217 227l104-3c4 0 6 3 5 7l-25 81c-1 4-4 5-8 5H189l25-86c1-2 2-4 3-4z" fill="url(#dorami-screen)" />
        <path d="M267 267c1-5 5-8 9-8-1 5-4 8-9 8zm-8 4c-3 2-4 6-3 10 1 6 5 11 8 11 2 0 3-2 6-2 2 0 4 2 6 1 3-1 5-5 7-10-3-1-5-3-5-6 0-2 1-4 3-5-4-3-8-3-11-1-3 1-7-2-11 2z" fill="#b5b8ba" stroke="none" transform="translate(270 276) scale(.82) translate(-270 -276)" />
      </g>
    </svg>
  </div>
  <button type="button" class="motion-toggle" aria-pressed="false" data-motion-toggle>움직임 멈춤</button>
</div>

<script>
  for (const companion of document.querySelectorAll<HTMLElement>('[data-rabbit-companion]')) {
    const toggle = companion.querySelector<HTMLButtonElement>('[data-motion-toggle]');
    if (!toggle || toggle.dataset.bound === 'true') continue;
    toggle.dataset.bound = 'true';
    toggle.addEventListener('click', () => {
      const paused = companion.classList.toggle('motion-paused');
      toggle.setAttribute('aria-pressed', String(paused));
      toggle.textContent = paused ? '움직임 재생' : '움직임 멈춤';
    });
  }
</script>
