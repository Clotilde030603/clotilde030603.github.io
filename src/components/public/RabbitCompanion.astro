        </g>
        <path fill="#697D4F" stroke="none" d="M80 31c6 6 10 15 9 24-6-6-9-15-9-24Z" />

        <g class="rabbit-face" fill="#30352F" stroke="none">
          <ellipse class="rabbit-eye rabbit-eye-left" cx="82" cy="89" rx="4" ry="5.5" />
