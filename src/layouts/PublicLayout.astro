---
import type { Category } from '../lib/types';
import Brand from '../components/public/Brand.astro';
import CategoryNav from '../components/public/CategoryNav.astro';
import RabbitCompanion from '../components/public/RabbitCompanion.astro';
import '../styles/public.css';

interface Props {
  title?: string;
  description?: string;
  categories: Category[];
  activeCategoryId?: string | null;
  canonicalPath?: string;
  articlePublishedAt?: string;
}

const {
  title,
  description = '보안 기술, 개인정보, 개발과 배움을 기록하는 Dorami 블로그',
  categories,
  activeCategoryId = null,
  canonicalPath = Astro.url.pathname,
  articlePublishedAt,
} = Astro.props;
const pageTitle = title ? `${title} · Dorami` : 'Dorami';
const canonical = new URL(canonicalPath, Astro.site ?? Astro.url.origin);
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="no-referrer" />
    <meta http-equiv="Content-Security-Policy" content="object-src 'none'; base-uri 'self'; form-action 'self'" />
    <meta name="description" content={description} />
    <meta property="og:type" content={articlePublishedAt ? 'article' : 'website'} />
    <meta property="og:site_name" content="Dorami" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    {articlePublishedAt && <meta property="article:published_time" content={articlePublishedAt} />}
    <meta name="theme-color" content="#FEFEFC" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/dorami-cartoon/dorami-rabbit-face.png" />
    <link rel="alternate" type="application/rss+xml" title="Dorami RSS" href="/rss.xml" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">본문으로 건너뛰기</a>
    <header class="site-header">
      <div class="header-inner">
        <Brand />
        <nav class="top-nav" aria-label="주 메뉴">
          <a href="/">글</a>
          <a href="/about/">소개</a>
          <a href="https://github.com/Clotilde030603" rel="me noreferrer">GitHub</a>
          <a class="search-link" href="/search/" aria-label="검색">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="m15.5 15.5 5 5"></path></svg>
          </a>
        </nav>
      </div>
    </header>

    <details class="mobile-categories">
      <summary><svg class="category-clover" viewBox="0 0 20 20" aria-hidden="true"><path d="M10 9.7C8.1 5.2 11 2 13.5 3.2c2.2 1.1 1 4.4-3.5 6.5 2.1-4.5 5.4-5.7 6.5-3.5C17.7 8.7 14.5 11.6 10 9.7Zm0 .6c1.9 4.5-1 7.7-3.5 6.5-2.2-1.1-1-4.4 3.5-6.5-2.1 4.5-5.4 5.7-6.5 3.5C2.3 11.3 5.5 8.4 10 10.3Z"/><path d="m10 10 3.4 6.2" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg><span>Category</span></summary>
      <CategoryNav categories={categories} activeCategoryId={activeCategoryId} instanceId="mobile-category" />
    </details>

    <div class="public-shell">
      <aside class="public-sidebar">
        <CategoryNav categories={categories} activeCategoryId={activeCategoryId} instanceId="desktop-category" />
        <RabbitCompanion />
        <p class="sidebar-signature">Dorami, also known as Clotilde.</p>
      </aside>
      <main id="main-content" tabindex="-1">
        <slot />
      </main>
      <div class="mobile-rabbit" aria-hidden="false">
        <RabbitCompanion />
        <p class="sidebar-signature">Dorami, also known as Clotilde.</p>
      </div>
    </div>

    <footer class="site-footer">
      <span>© {new Date().getFullYear()} Dorami</span>
      <a href="/rss.xml">RSS</a>
    </footer>
    <script is:inline type="module" src="/dorami-cartoon/dorami-rabbit.js"></script>
  </body>
</html>
