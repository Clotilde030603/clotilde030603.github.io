---
import type { Category, PublishedPost } from '../lib/types';
import Brand from '../components/public/Brand.astro';
import CategoryNav from '../components/public/CategoryNav.astro';
import RabbitCompanion from '../components/public/RabbitCompanion.astro';
import '../styles/public.css';

interface Props {
  title?: string;
  description?: string;
  categories: Category[];
  posts: PublishedPost[];
  activeCategoryId?: string | null;
  canonicalPath?: string;
  articlePublishedAt?: string;
  homePage?: boolean;
}

const {
  title,
  description = '보안 기술, 개인정보, 개발과 배움을 기록하는 Dorami 블로그',
  categories,
  posts,
  activeCategoryId = null,
  canonicalPath = Astro.url.pathname,
  articlePublishedAt,
  homePage = false,
} = Astro.props;
const pageTitle = title ? `${title} · Dorami` : 'Dorami';
const canonical = new URL(canonicalPath, Astro.site ?? Astro.url.origin);
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="no-referrer" />
    <meta http-equiv="Content-Security-Policy" content="object-src 'none'; base-uri 'self'; form-action 'self'" />
    <meta name="description" content={description} />
    <meta property="og:type" content={articlePublishedAt ? 'article' : 'website'} />
    <meta property="og:site_name" content="Dorami" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    {articlePublishedAt && <meta property="article:published_time" content={articlePublishedAt} />}
    <meta name="theme-color" content="#FEFEFC" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/dorami-cartoon/dorami-rabbit-face.png" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">본문으로 건너뛰기</a>
    <header class="site-header">
      <div class="header-inner">
        <Brand />
        <nav class="top-nav" aria-label="주 메뉴">
          <a href="/">HOME</a>
          <a href="/posts/">POSTS</a>
          <a href="/about/">ABOUT</a>
          <a href="https://github.com/Clotilde030603" rel="me noreferrer">GitHub</a>
          <a class="search-link" href="/search/" aria-label="검색">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="m15.5 15.5 5 5"></path></svg>
          </a>
        </nav>
      </div>
    </header>

    {!homePage && (
      <details class="mobile-categories">
        <summary><svg class="category-clover" viewBox="0 0 20 20" aria-hidden="true"><path d="m10 10 5.2 7" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/><circle cx="6.2" cy="6.2" r="4.1"/><circle cx="13.8" cy="6.2" r="4.1"/><circle cx="6.2" cy="13.8" r="4.1"/><circle cx="13.8" cy="13.8" r="4.1"/></svg><span>Category</span></summary>
        <CategoryNav categories={categories} posts={posts} activeCategoryId={activeCategoryId} instanceId="mobile-category" />
      </details>
    )}

    <div class:list={['public-shell', homePage && 'home-shell']}>
      {!homePage && (
        <aside class="public-sidebar">
          <CategoryNav categories={categories} posts={posts} activeCategoryId={activeCategoryId} instanceId="desktop-category" />
          <RabbitCompanion />
          <p class="sidebar-signature">Dorami, also known as Clotilde.</p>
        </aside>
      )}
      <main id="main-content" tabindex="-1">
        <slot />
      </main>
      {!homePage && (
        <div class="mobile-rabbit" aria-hidden="false">
          <RabbitCompanion />
          <p class="sidebar-signature">Dorami, also known as Clotilde.</p>
        </div>
      )}
    </div>

    <footer class="site-footer">
      <span>© {new Date().getFullYear()} Dorami</span>
    </footer>
    <script is:inline type="module" src="/dorami-cartoon/dorami-rabbit.js"></script>
  </body>
</html>
